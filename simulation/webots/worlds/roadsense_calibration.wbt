# RoadSense sensor calibration laboratory (Stage W2). Diagnostic only: no SUMO, no road, no driving logic.
# The ego is the highway world's EGO_ROADSENSE (LincolnMKZ) with the same radars, IbeoLux lidars, cameras, GPS and
# inertial unit at the same poses, plus diagnostic and experimental devices that stay off unless a calibration plan
# enables them. Targets reproduce SUMO's traffic nodes: a physics-less wrapper Solid with the Webots vehicle model
# offset behind it (car -2.85 m, truck -5.2 m, motorcycle -1.7 m), parked at x = 10000 until a case places them.
# roadsense_calib (supervisor) places the targets and records ground truth beside the raw sensor output.
WorldInfo {
  info [
    "RoadSense sensor calibration laboratory: known targets around the EGO_ROADSENSE sensor set."
    "Derived from roadsense_highway.wbt (itself from the Webots R2025b highway_overtake sample, Cyberbotics Ltd., Apache License 2.0), see simulation/webots/THIRD_PARTY_NOTICES.md."
  ]
  title "RoadSense Calibration Lab"
  ERP 0.6
  basicTimeStep 10
  lineScale 1
  contactProperties [
    ContactProperties {
      coulombFriction [
        8
      ]
      softCFM 1e-05
      bumpSound ""
      rollSound ""
      slideSound ""
    }
    ContactProperties {
      material2 "LincolnMKZWheels"
      coulombFriction [
        8
      ]
      softCFM 1e-05
      bumpSound ""
      rollSound ""
      slideSound ""
    }
  ]
}
Viewpoint {
  orientation -0.2 0 0.98 3.1
  position -18 2 8
  near 1
  follow "EGO_ROADSENSE"
  followSmoothness 0
}
TexturedBackground {
}
TexturedBackgroundLight {
}
DEF FLOOR Solid {
  translation 2000 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.35 0.37
        roughness 1
        metalness 0
      }
      geometry Plane {
        size 8000 400
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 8000 400
  }
}
DEF WEBOTS_VEHICLE0 LincolnMKZ {
  translation -1900 0 0.4
  name "EGO_ROADSENSE"
  controller "roadsense_calib"
  supervisor TRUE
  sensorsSlotFront [
    DEF FRONT_RIGHT_LIDAR IbeoLux {
      translation -0.225167 0.71 0
      rotation 0 0 1 0.785398
      name "ibeo 1"
      useExtendedFieldOfView TRUE
    }
    DEF FRONT_LEFT_LIDAR IbeoLux {
      translation -0.225 -0.71 0
      rotation 0 0 -1 0.819204
      name "ibeo 2"
      useExtendedFieldOfView TRUE
    }
    Radar {
      translation 0.11 0 0
      name "radar front"
      maxRange 150
      horizontalFieldOfView 2.6
      verticalFieldOfView 0.07854
      rangeNoise 0.25
      speedNoise 0.12
      angularNoise 0.001
      frequency 76.5
      transmittedPower 31
      minDetectableSignal -80
      occlusion TRUE
    }
    Radar {
      translation 0.11 0 0
      name "diag radar front"
      maxRange 150
      horizontalFieldOfView 2.6
      verticalFieldOfView 0.07854
      frequency 76.5
