    DEF REAR_RIGHT_LIDAR IbeoLux {
      translation -0.189857 -0.75851 0
      rotation 0 0 1 -0.7915953071795858
      name "ibeo 4"
      useExtendedFieldOfView TRUE
    }
    Radar {
      translation 0.1 0 0
      name "radar rear"
      maxRange 100
