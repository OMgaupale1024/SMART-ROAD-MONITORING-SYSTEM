DEF T_BOX_C Solid {
  translation 10000 0 0.75
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.5 0.1
        metalness 0
      }
      geometry DEF BOX_C_GEOM Box {
        size 4.5 1.8 1.5
      }
    }
  ]
  name "box centred"
  model "calibration box, origin at its centre"
  boundingObject USE BOX_C_GEOM
  radarCrossSection 100
}
DEF T_BOX_O Solid {
  translation 10000 10 0.317
  children [
    Pose {
      translation 1.4 0 0.433
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.5 0.8
            metalness 0
          }
          geometry DEF BOX_O_GEOM Box {
            size 4.5 1.8 1.5
          }
        }
      ]
    }
  ]
  name "box offset"
  model "calibration box, origin 1.4 m behind its centre like a car's rear axle"
  boundingObject Pose {
    translation 1.4 0 0.433
    children [
      USE BOX_O_GEOM
    ]
  }
  radarCrossSection 100
}
