      maxRange 100
      horizontalFieldOfView 2.6
      verticalFieldOfView 0.07854
      frequency 76.5
      transmittedPower 31
      minDetectableSignal -80
      occlusion TRUE
    }
  ]
  sensorsSlotTop [
    Camera {
      translation 0.5 0 0
      name "hazard camera"
      fieldOfView 0.87
      width 512
      height 256
      recognition Recognition {
        maxRange 60
        frameThickness 0
      }
    }
    Camera {
      translation 0.5 0 0
      name "exp camera 720p"
      fieldOfView 1.05
      width 1280
      height 720
      near 0.5
      far 300
    }
    Lidar {
      translation 0 0 0.35
      name "exp lidar roof"
      horizontalResolution 1800
      fieldOfView 6.283
