# Virtual environments
.venv/
venv/
env/

# Credentials and local agent/cloud configuration
.env
.env.*
!.env.example
.aws/
.ssh/
.codex/
*.pem
*.key
credentials.json
secrets.json

# Local logs, temporary artifacts and backups
*.log
*.tmp
*.bak
*.tar.gz
*.tgz
*.zip
backups/

# Python caches / build
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/

# Local application data / databases (must never be committed)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Exports produced at runtime (desktop CSVs, web session ZIPs)
telemetry.csv
events.csv
session_metadata.csv
roadsense_session_*.zip

# Webots window layout, rewritten each time a world closes
*.wbproj

# remember plugin state (self-ignored, but be explicit)
.remember/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
